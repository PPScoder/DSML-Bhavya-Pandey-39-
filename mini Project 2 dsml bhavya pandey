      "Cleaned data: (290584, 5)\n"
     ]
    }
   ],
   "source": [
    "ab = ab[\n",
    "    ((ab[\"group\"] == \"control\") & (ab[\"landing_page\"] == \"old_page\")) |\n",
    "    ((ab[\"group\"] == \"treatment\") & (ab[\"landing_page\"] == \"new_page\"))\n",
    "]\n",
    "\n",
    "# Remove duplicate users\n",
    "ab = ab.drop_duplicates(\"user_id\")\n",
    "\n",
    "print(\"Cleaned data:\", ab.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "ca28b0b8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
