      "CA     14499\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "countries = countries.drop_duplicates(\"user_id\")\n",
    "\n",
    "data = ab.merge(countries, on=\"user_id\", how=\"inner\")\n",
    "\n",
    "print(\"\\nCountry distribution:\")\n",
    "print(data[\"country\"].value_counts())"
   ]
  },
  {
