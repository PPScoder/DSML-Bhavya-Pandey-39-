      "p-value: 0.1918\n"
     ]
    }
   ],
   "source": [
    "table = pd.crosstab(\n",
    "    data[\"group\"],\n",
    "    data[\"converted\"]\n",
    ")\n",
    "\n",
    "chi2, chi_p, dof, expected = chi2_contingency(table)\n",
    "\n",
    "print(\"\\nChi-Square Test\")\n",
    "print(\"Chi-square:\", round(chi2, 4))\n",
    "print(\"p-value:\", round(chi_p, 4))"
   ]
  },
