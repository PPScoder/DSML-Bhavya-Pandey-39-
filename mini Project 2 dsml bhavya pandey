   "source": [
    "ab = pd.read_csv(\"https://raw.githubusercontent.com/piyushsachdv/Piyush_Sachdeva_09_DSML/main/ab_data.csv\")\n",
    "countries = pd.read_csv(\"https://raw.githubusercontent.com/piyushsachdv/Piyush_Sachdeva_09_DSML/main/countries.csv\")\n",
    "\n",
    "print(\"Original data:\", ab.shape)\n"
   ]
  },
