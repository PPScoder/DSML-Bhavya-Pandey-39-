   "source": [
    "t_stat, t_p = ttest_ind(\n",
    "    treatment,\n",
    "    control,\n",
    "    equal_var=False\n",
    ")\n",
    "\n",
    "print(\"\\nWelch T-Test\")\n",
    "print(\"t-statistic:\", round(t_stat, 4))\n",
    "print(\"p-value:\", round(t_p, 4))"
   ]
  },
